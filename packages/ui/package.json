{
  "name": "@tuprolog/arg2p-ui",
  "version": "0.1.0",
  "description": "The user interface of Arg2P as web components (graphs, solutions, ...), on any engine: the solver of the browser, or one of the JVM",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Giuseppe Pisano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuProlog/arg2p-kt-web.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./js": {
      "types": "./dist/js/index.d.ts",
      "import": "./dist/js/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tuprolog/arg2p": ">=0.19.1"
  },
  "peerDependenciesMeta": {
    "@tuprolog/arg2p": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "cytoscape": "3.34.3",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@tuprolog/arg2p": "0.19.1",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
